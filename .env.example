# Chat LLM
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Embedding (optional; falls back to keyword if blank)
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# Memory backends
# SHORT_TERM_BACKEND options:
#   "memory" (default, in-process deque, lost on restart)
#   "redis"  (persistent, cross-restart, supports cross-process)
# VECTOR_BACKEND options:
#   "local"  (default, sessions/memory.jsonl, no service)
#   "qdrant"  (real Qdrant, requires docker compose qdrant service)
#   "chroma"  (real Chroma, requires docker compose chromadb service)
#
# When using docker compose, use SERVICE NAMES (not localhost):
#   REDIS_URL=redis://redis:6379/0    (NOT localhost — that's the container itself)
#   QDRANT_URL=http://qdrant:6333
SHORT_TERM_BACKEND=memory
VECTOR_BACKEND=local
REDIS_URL=
QDRANT_URL=

# Tech-trend data sources (Phase R1)
# TREND_PROVIDER options:
#   unset or "mock" — use deterministic mock data (default, offline)
#   "real"           — call GitHub / Remotive / HN Algolia APIs
# If real source fails, falls back to mock automatically (notes
# include "[FALLBACK]" marker). Set GITHUB_TOKEN for higher rate
# limit on GitHub.
#TREND_PROVIDER=real
#GITHUB_TOKEN=

# Runtime
MAX_TOOL_ITERS=8
CONTEXT_MAX_MESSAGES=20
RECENT_KEEP=8
